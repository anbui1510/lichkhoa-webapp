# Cloudflare Pages — MỘT URL, NHIỀU KHOA (dropdown + vai trò theo từng Sheet)
# Production + Preview. IT chỉnh spreadsheetId sau khi từng khoa có file Sheet.

VITE_DATA_BACKEND=sheet
VITE_SHEET_BRIDGE_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
VITE_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# JSON một dòng (hoặc multiline trên dashboard). Mỗi khoa = một Spreadsheet.
# NhanSu mỗi file: loginEmail + accessRole admin|member — vai trò A khác nhau mỗi khoa là bình thường.
VITE_TENANT_REGISTRY=[{"slug":"tim-mach","label":"Khoa Tim mạch","spreadsheetId":"1ABC_TIM_MACH"},{"slug":"tieu-hoa","label":"Khoa Tiêu hóa","spreadsheetId":"1XYZ_TIEU_HOA"}]