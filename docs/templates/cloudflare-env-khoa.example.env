# TUỲ CHỌN — Pilot một khoa / một Pages project riêng (Chế độ A trong DEPLOY-MULTI-KHOA.md)
# KHÔNG bắt buộc khi dùng một URL chung + admin «Lưu kết nối sổ» trong app.
#
# Cấu hình mặc định đa khoa: dùng cloudflare-env-minimal.example.env thay file này.

VITE_DATA_BACKEND=sheet
VITE_SHEET_BRIDGE_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
VITE_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# Tuỳ chọn — email/mật khẩu:
# VITE_API_BASE=https://lichkhoa-webapp.onrender.com/api

# Chỉ khi muốn mở URL là đã gán sẵn tên + Sheet (không thay cho admin lưu link trong app):
# VITE_TENANT_SLUG=timmach
# VITE_TENANT_LABEL=Khoa Tim mạch
# VITE_DEFAULT_SPREADSHEET_ID=SPREADSHEET_ID
# VITE_TENANT_DEPARTMENTS=[{"id":"dept_tim_mach","name":"Tim mạch"}]