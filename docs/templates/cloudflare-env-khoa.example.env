# Cloudflare Pages — Production env (Chế độ A, một project / khoa)
# Copy vào Dashboard → Project → Settings → Environment variables → Production
# Thay SLUG, LABEL, SPREADSHEET_ID; giữ API + bridge nếu dùng chung toàn hệ thống.

VITE_DATA_BACKEND=sheet
VITE_SHEET_BRIDGE_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
VITE_API_BASE=https://lichkhoa-webapp.onrender.com/api

VITE_TENANT_SLUG=SLUG
VITE_TENANT_LABEL=Khoa LABEL
VITE_DEFAULT_SPREADSHEET_ID=SPREADSHEET_ID

# Tuỳ chọn — phòng/khoa con trong một Sheet (JSON một dòng):
# VITE_TENANT_DEPARTMENTS=[{"id":"dept_example","name":"Tên phòng"}]
