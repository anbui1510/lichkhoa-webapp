PORT=4000
DATABASE_URL="file:./dev.db"
JWT_SECRET="doi-chuoi-bi-mat-nay-khi-deploy"
JWT_EXPIRES_IN="7d"
CLIENT_ORIGIN="http://localhost:5173"
# OAuth Client ID (Web) từ Google Cloud. Origin được phép: http://localhost:5173
GOOGLE_CLIENT_ID=""
# CSV email được phép bootstrap/giữ Admin qua Google (kể cả khi khoa đã có Admin).
# Ví dụ: BOOTSTRAP_ADMIN_EMAILS="truongkhoa@bv.vn,pho.khoa@bv.vn"
# Nếu trống và chưa có user role=Admin: lần Google login đầu tiên được gán Admin (first-user).
BOOTSTRAP_ADMIN_EMAILS=""

# --- Google Sheets SoT (F-103 link + F-210 sync lịch) ---
# 1) Google Cloud Console → tạo Service Account → Enable "Google Sheets API"
# 2) Tạo JSON key → lấy client_email + private_key
# 3) Dán vào đây (private_key giữ \n hoặc xuống dòng thật trong .env)
# 4) Mở Spreadsheet SoT → Share → thêm client_email với quyền Editor (bắt buộc để ghi lịch)
# 5) Trong app: Cài đặt → lưu ID/URL Sheet (Admin)
# Thiếu credentials: vẫn lưu link Sheet (format OK); GET/PUT /api/schedule/data trả 503.
GOOGLE_SHEETS_CLIENT_EMAIL="lichkhoa-sa@project.iam.gserviceaccount.com"
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

UPLOAD_DIR="../public/uploads"
# Optional — nếu có thì avatar upload lên Cloudinary thay vì disk local
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
