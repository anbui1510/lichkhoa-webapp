PORT=4000

# Postgres — Project: https://radescazwukbdfgqmepd.supabase.co
# Settings → Database → Connection string → URI (thay YOUR_PASSWORD)
# Direct:
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.radescazwukbdfgqmepd.supabase.co:5432/postgres"
# Session pooler (nếu direct bị chặn): postgresql://postgres.radescazwukbdfgqmepd:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

JWT_SECRET="doi-chuoi-bi-mat-nay-khi-deploy"
JWT_EXPIRES_IN="7d"

# CORS frontend — localhost luôn được phép
# Một origin (legacy):
# CLIENT_ORIGIN="https://lichkhoa-webapp.pages.dev"
# Nhiều khoa (<20): suffix khớp https://{slug}-lichkhoa-webapp.pages.dev và lichkhoa-webapp.pages.dev
CLIENT_ORIGIN_SUFFIX="-lichkhoa-webapp.pages.dev"
# Hoặc liệt kê tay:
# CLIENT_ORIGINS="https://lichkhoa-webapp.pages.dev,https://nhiem-lichkhoa-webapp.pages.dev"

# OAuth Client ID (Web) từ Google Cloud. Origin được phép: http://localhost:5173
GOOGLE_CLIENT_ID=""

UPLOAD_DIR="../public/uploads"
# Optional — nếu có thì avatar upload lên Cloudinary thay vì disk local
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
