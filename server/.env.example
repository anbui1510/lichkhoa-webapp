PORT=4000

# Postgres — dùng connection string từ Supabase (Settings → Database → URI)
# Ví dụ (Session pooler): postgresql://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Hoặc Direct: postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"

JWT_SECRET="doi-chuoi-bi-mat-nay-khi-deploy"
JWT_EXPIRES_IN="7d"

# Origin frontend (Vite local hoặc URL Cloudflare / hosting)
CLIENT_ORIGIN="http://localhost:5173"

# OAuth Client ID (Web) từ Google Cloud. Origin được phép: http://localhost:5173
GOOGLE_CLIENT_ID=""

UPLOAD_DIR="../public/uploads"
# Optional — nếu có thì avatar upload lên Cloudinary thay vì disk local
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
