generator client {
  provider = "prisma-client-js"
}

// Default: SQLite (file). For production PostgreSQL set:
//   provider = "postgresql"
//   url      = env("DATABASE_URL")
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  googleId     String?  @unique
  passwordHash String
  /// Auth role SoT: "Admin" | "Mod" | "User" | "" (pending). Client chỉ đọc; authorize trên server.
  role         String   @default("")
  fullName     String
  phone        String   @default("")
  birthDate    String   @default("")
  country      String   @default("Việt Nam")
  address      String   @default("")
  avatarUrl    String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  settings     UserSetting?
  rosterLink   RosterPerson?
}

model UserSetting {
  id                 String  @id @default(cuid())
  userId             String  @unique
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailNotifications Boolean @default(true)
  pushNotifications  Boolean @default(true)
  darkMode           Boolean @default(false)
  language           String  @default("vi")
  twoFactorEnabled   Boolean @default(false)
  privacyMode        Boolean @default(false)
}

/// Singleton cấu hình Spreadsheet SoT của khoa (Epic 1 / F-103). Không lưu lưới lịch.
model DeptScheduleConfig {
  id            String    @id @default("default")
  spreadsheetId String
  title         String    @default("")
  verifiedAt    DateTime?
  updatedById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// Danh sách tên + role do Admin setup (Epic 1 / F-104). Link Google ở F-105.
model RosterPerson {
  id           String   @id @default(cuid())
  displayName  String
  /// "Admin" | "Mod" | "User"
  role         String
  linkedUserId String?  @unique
  linkedUser   User?    @relation(fields: [linkedUserId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
